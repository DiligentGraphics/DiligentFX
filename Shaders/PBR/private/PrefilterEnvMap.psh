#include "PBR_PrecomputeCommon.fxh"
#include "ShaderUtilities.fxh"
#include "SphereMapSampling.fxh"

#ifndef OPTIMIZE_SAMPLES
#   define OPTIMIZE_SAMPLES 1
#endif

#ifndef PREFILTER_ENV_MAP_CHARLIE
#   define PREFILTER_ENV_MAP_CHARLIE 0
#endif

#if ENV_MAP_TYPE == ENV_MAP_TYPE_CUBE
TextureCube  g_EnvironmentMap;
#elif ENV_MAP_TYPE == ENV_MAP_TYPE_SPHERE
Texture2D    g_EnvironmentMap;
#elif ENV_MAP_TYPE == ENV_MAP_TYPE_SPHERE_ARRAY
Texture2DArray g_EnvironmentMap;
#endif
SamplerState g_EnvironmentMap_sampler;

cbuffer cbConstants
{
    float4x4 g_Rotation;
    float4   g_EnvMapUVScaleBias;

    float g_Roughness;
    float g_EnvMapWidth;
    float g_EnvMapHeight;
    float g_EnvMipCount;

    float g_EnvMapSlice;
    uint  g_NumSamples;
    int   g_SphereMapRow0IsNegativeY;
    uint  g_Padding1;
}

float3 SampleEnvrionmentMap(float3 R, float MipLevel)
{
#if ENV_MAP_TYPE == ENV_MAP_TYPE_CUBE
    return g_EnvironmentMap.SampleLevel(g_EnvironmentMap_sampler, R, MipLevel).rgb;
#elif ENV_MAP_TYPE == ENV_MAP_TYPE_SPHERE || ENV_MAP_TYPE == ENV_MAP_TYPE_SPHERE_ARRAY
    float2 UV = TransformDirectionToSphereMapUV(R, g_SphereMapRow0IsNegativeY != 0);
#    if ENV_MAP_TYPE == ENV_MAP_TYPE_SPHERE_ARRAY
    return SampleSphereMapAtlas(g_EnvironmentMap, g_EnvironmentMap_sampler, UV,
                                g_EnvMapSlice, g_EnvMapUVScaleBias,
                                float2(g_EnvMapWidth, g_EnvMapHeight), MipLevel, g_EnvMipCount);
#    else
    return g_EnvironmentMap.SampleLevel(g_EnvironmentMap_sampler, UV, MipLevel).rgb;
#    endif
#endif
}

#if OPTIMIZE_SAMPLES
// Select a source mip from the sample footprint. DirectionY determines latitude
// for spherical maps and is ignored for cubemaps.
float ComputeEnvironmentMapMipLevel(float OmegaS, float DirectionY)
{
#if ENV_MAP_TYPE == ENV_MAP_TYPE_CUBE
    float OmegaP = ComputeCubeMapPixelSolidAngle(g_EnvMapWidth, g_EnvMapHeight);
#else
    float OmegaP = ComputeSphereMapPixelSolidAngle(
        g_EnvMapWidth, g_EnvMapHeight, acos(DirectionY), 1.0);
#endif
    // A positive bias improves filtering of very bright environment texels.
    float MipBias = 1.0;
    return clamp(0.5 * log2(OmegaS / max(OmegaP, 1e-10)) + MipBias,
                 0.0, g_EnvMipCount - 1.0);
}
#endif

#if PREFILTER_ENV_MAP_CHARLIE
#include "SheenSampling.fxh"

Texture2D<float> g_SheenSampling;

// Sample the normalized, view-averaged Charlie kernel around the surface normal.
float3 PrefilterSheenEnvMap(float Roughness, float3 N)
{
    uint Width, Height;
    g_SheenSampling.GetDimensions(Width, Height);
    float Row = saturate(Roughness) * float(Height - 1u);
    uint Row0 = min(uint(Row), Height - 2u);
    float RowWeight = Row - float(Row0);

    float3 Color = float3(0.0, 0.0, 0.0);
    for (uint i = 0u; i < g_NumSamples; ++i)
    {
        // Midpoints avoid the inverse CDF's singular probability endpoints.
        float U = (float(i) + 0.5) / float(g_NumSamples);
        float Position = SheenSamplingCoordinate(U) * float(Width - 1u);
        uint Column = min(uint(Position), Width - 2u);
        float U0 = SheenSamplingProbability(float(Column) / float(Width - 1u));
        float U1 = SheenSamplingProbability(float(Column + 1u) / float(Width - 1u));
        float Q0 = lerp(g_SheenSampling.Load(int3(int(Column), int(Row0), 0)),
                        g_SheenSampling.Load(int3(int(Column), int(Row0 + 1u), 0)), RowWeight);
        float Q1 = lerp(g_SheenSampling.Load(int3(int(Column + 1u), int(Row0), 0)),
                        g_SheenSampling.Load(int3(int(Column + 1u), int(Row0 + 1u), 0)), RowWeight);
        float CosTheta = saturate(lerp(Q0, Q1, (U - U0) / (U1 - U0)));
        float SinTheta = sqrt(saturate(1.0 - CosTheta * CosTheta));
        float Phi = 2.0 * PI * Hammersley2D(i, g_NumSamples).y;
        float3 L = TransformHemisphereSampleToWorld(
            float3(SinTheta * cos(Phi), SinTheta * sin(Phi), CosTheta), N);

        float MipLevel = 0.0;
#if OPTIMIZE_SAMPLES
        // The footprint comes from the interpolated quantile distribution,
        // not the original Charlie NDF.
        float OmegaS = 2.0 * PI * max(Q1 - Q0, 0.0) /
                       (float(g_NumSamples) * (U1 - U0));
        // The zero-roughness tangent-circle distribution stays at source LOD zero.
        if (Roughness > 0.0 && OmegaS > 0.0)
            MipLevel = ComputeEnvironmentMapMipLevel(OmegaS, clamp(L.y, -1.0, 1.0));
#endif
        // The normalized kernel is the sampling distribution: no extra BRDF
        // or NdotL weights are needed.
        Color += SampleEnvrionmentMap(L, MipLevel);
    }
    return Color / float(g_NumSamples);
}

#else

// GGX split-sum filtering approximates V = N = R and weights reflected
// half-vector samples by NdotL. Normalization preserves a constant environment.
// https://blog.selfshadow.com/publications/s2013-shading-course/karis/s2013_pbs_epic_notes_v2.pdf
float3 PrefilterGGXEnvMap(float PerceptualRoughness, float3 R)
{
    float3 N = R;
    float3 V = R;
#if OPTIMIZE_SAMPLES
    float AlphaRoughness = PerceptualRoughness * PerceptualRoughness;
#endif

    float3 PrefilteredColor = float3(0.0, 0.0, 0.0);
    float TotalWeight = 0.0;
    for (uint i = 0u; i < g_NumSamples; ++i)
    {
        float2 Xi = Hammersley2D(i, g_NumSamples);
        float3 H  = ImportanceSampleGGX(Xi, PerceptualRoughness, N);
        float3 L  = 2.0 * dot(V, H) * H - V;
        float NoL = clamp(dot(N, L), 0.0, 1.0);
        float VoH = clamp(dot(V, H), 0.0, 1.0);
        if (NoL > 0.0 && VoH > 0.0)
        {
            float MipLevel = 0.0;
#if OPTIMIZE_SAMPLES
            float pdf = max(SmithGGXSampleDirectionPDF(V, N, L, AlphaRoughness), 0.0001);
            float OmegaS = 1.0 / (float(g_NumSamples) * pdf);
            if (AlphaRoughness != 0.0)
                MipLevel = ComputeEnvironmentMapMipLevel(OmegaS, L.y);
#endif
            PrefilteredColor += SampleEnvrionmentMap(L, MipLevel) * NoL;
            TotalWeight += NoL;
        }
    }
    return PrefilteredColor / TotalWeight;
}
#endif


void main(in float4  Pos      : SV_Position,
          in float3  WorldPos : WORLD_POS,
          out float4 Color    : SV_Target)
{		
    float3 R = normalize(WorldPos);
#if PREFILTER_ENV_MAP_CHARLIE
    Color.rgb = PrefilterSheenEnvMap(g_Roughness, R);
#else
    Color.rgb = PrefilterGGXEnvMap(g_Roughness, R);
#endif
    Color.a = 0.0;
}
