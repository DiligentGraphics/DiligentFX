#include "FullScreenTriangleVSOutput.fxh"
#include "PBR_PrecomputeCommon.fxh"

#ifndef NUM_SAMPLES
#    define NUM_SAMPLES 512u
#endif

// Integrate the Charlie directional albedo for a fixed view and roughness:
//
//   A(NdotV, r) = integral[D_Charlie(NdotH, r) * Visibility(NdotL, NdotV, r) * NdotL dOmegaL]
//
// This is the reflected response to unit radiance over the upper hemisphere,
// with unit sheen color. N = (0, 0, 1), V is fixed, and H = normalize(V + L).
// No environment texture is sampled, and viewing directions are not averaged;
// the view-averaged environment-filter distribution is generated separately.
//
// Sample L directly using a grazing-biased, low-discrepancy distribution:
//   U = (i + 0.5) / NumSamples, NdotL = U^2,
//   Phi = 2 * PI * radicalInverseBase2(i).
// Squaring U concentrates samples near the horizon to resolve grazing lobes.
// This fixed distribution is independent of roughness and NdotV; it is not
// cosine-weighted sampling or Charlie half-vector importance sampling.
//
// Since dOmegaL = dPhi * d(NdotL), the solid-angle PDF is
//   p(L) = 1 / (4 * PI * sqrt(NdotL)) = 1 / (4 * PI * U).
// Each BRDF * NdotL contribution is therefore weighted by 4 * PI * U.
// The common 4 * PI / NumSamples factor is applied after accumulation.
float IntegrateSheenBRDF(float SheenRoughness, float NdotV, uint NumSamples)
{
    if (SheenRoughness <= 0.0)
        return 0.0;

    float3 V = float3(sqrt(saturate(1.0 - NdotV * NdotV)), 0.0, NdotV);
    float DirectionalAlbedo = 0.0;
    for (uint i = 0u; i < NumSamples; ++i)
    {
        // Midpoints avoid the polar endpoints. Hammersley's radical-inverse
        // coordinate distributes the azimuth angles around the normal.
        float U        = (float(i) + 0.5) / float(NumSamples);
        float Phi      = 2.0 * PI * Hammersley2D(i, NumSamples).y;
        float CosTheta = U * U;
        float SinTheta = sqrt(saturate(1.0 - CosTheta * CosTheta));
        float3 L       = float3(SinTheta * cos(Phi), SinTheta * sin(Phi), CosTheta);
        float3 H       = normalize(V + L);
        DirectionalAlbedo +=
            U * CosTheta * NormalDistribution_Charlie(saturate(H.z), SheenRoughness) *
            SheenVisibility(CosTheta, NdotV, SheenRoughness);
    }
    DirectionalAlbedo *= 4.0 * PI / float(NumSamples);

    // Both the normalized IBL map and punctual-light layering use this albedo.
    return DirectionalAlbedo;
}

void PrecomputeSheenBRDF_PS(FullScreenTriangleVSOutput VSOut,
                            out float                  SheenBRDF : SV_Target)
{
    // LUT axes: X = NdotV, Y = sheen roughness.
    float2 UV = NormalizedDeviceXYToTexUV(VSOut.f2NormalizedXY);
    SheenBRDF = IntegrateSheenBRDF(UV.y, UV.x, NUM_SAMPLES);
}
