{
  "name": "@diligentgraphics/radient",
  "version": "0.1.0-dev.0",
  "description": "Radient scene loading, inspection, animation, and WebGPU rendering",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {"type": "git", "url": "https://github.com/DiligentGraphics/DiligentEngine.git"},
  "exports": {
