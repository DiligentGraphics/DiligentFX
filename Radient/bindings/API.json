{
  "schema_version": 1,
  "conventions": "diligent",
  "headers": [
    "Radient/interface/Radient.h",
    "Radient/bindings/javascript/BrowserNative.h",
    "../DiligentCore/Common/interface/ThreadPool.h"
  ],
  "exports": {
    "headers": [
      "Radient/interface/*.h",
      "Radient/bindings/javascript/BrowserNative.h"
    ],
    "exclude_headers": [
      "Radient/interface/RadientAssetResolver.h",
      "Radient/interface/RadientBackend.h"
    ],
    "exclude": [
      "Diligent::RadientDataBlobReadReleaseCallbackType",
      "Diligent::RadientDataBlobDestroyCallbackType",
      "Diligent::RadientAnimationPropertyBindingDesc",
      "Diligent::RadientAnimationResolvedPropertyDesc",
      "Diligent::IRadientAnimationDestinationBinding",
      "Diligent::RadientSurfaceMaterialDefinitionDesc",
      "Diligent::RadientPostProcessMaterialDefinitionDesc",
      "Diligent::RadientComputeMaterialDefinitionDesc",
      "Diligent::RadientCustomComponentData"
    ],
    "include": ["Diligent::RADIENT_MAX_ACTIVE_MORPH_TARGET_COUNT"]
  },
  "declarations": {
    "Diligent::IObject": {"binding": "external", "reason": "The language runtime supplies reference counting and interface queries.", "ownership": "reference_counted"},
    "Diligent::RADIENT_STATUS": {"role": "status"},
    "Diligent::RadientDataBlobCreateInfo": {
      "fields": {
        "pData": {"binding": "manual", "reason": "COPY borrows Size bytes for creation; REFERENCE retains their address until destruction. A backend must provide the corresponding storage lifetime.", "length": "Size"},
        "OnLastReaderReleased": {"binding": "manual", "reason": "Callback invocation may occur on a native worker; language runtime dispatch and callback retention need an adapter."},
        "pUserData": {"binding": "manual", "reason": "Opaque context is owned by the callback adapter, not exposed as a language pointer."},
        "OnDestroy": {"binding": "manual", "reason": "The callback adapter releases retained context on blob destruction and handles failed creation separately."}
      }
    },
    "Diligent::IRadientDataBlob": {
      "methods": {
        "BeginRead": {
          "binding": "manual",
          "reason": "A scoped access adapter retains the blob and pairs successful BeginRead with EndRead; empty blobs may return a null data pointer.",
          "parameters": {
            "ppData": {"lifetime": "read_scope"}
          }
        },
        "EndRead": {"binding": "manual", "reason": "Called by the scoped read-access adapter."}
      }
    },
    "Diligent::IRadientMutableDataBlob": {
      "methods": {
        "BeginWrite": {
          "binding": "manual",
          "reason": "A scoped access adapter retains the blob and pairs successful BeginWrite with EndWrite; empty blobs may return a null data pointer.",
          "parameters": {
            "ppData": {"lifetime": "write_scope"}
          }
        },
        "EndWrite": {"binding": "manual", "reason": "Called by the scoped write-access adapter."}
      }
    },
    "Diligent::RadientBackendCreateInfo": {"binding": "external", "reason": "Engine configuration uses native defaults until this subsystem is exposed."},
    "Diligent::RadientAssetManagerCreateInfo": {"binding": "external", "reason": "Engine configuration uses native defaults until this subsystem is exposed."},
    "Diligent::RadientResourceManagerCreateInfo": {"binding": "external", "reason": "Engine configuration uses native defaults until this subsystem is exposed."},
    "Diligent::IThreadPool": {"binding": "external", "reason": "Engine configuration uses native defaults until this subsystem is exposed."},
    "Diligent::RadientEngineCreateInfo": {
      "fields": {
        "pThreadPool": {"binding": "manual", "reason": "Supplying a native thread pool requires a platform adapter."}
      }
    },
    "Diligent::IRadientEngine": {
      "exclude_methods": ["GetBackend"]
    },
    "Diligent::IDeviceContext": {"binding": "external", "reason": "The browser adapter supplies the native graphics context."},
    "Diligent::ISwapChain": {"binding": "external", "reason": "The browser adapter owns the canvas swap chain."},
    "Diligent::ITextureView": {"binding": "external", "reason": "Native texture views are supplied by the platform adapter."},
    "Diligent::IRadientRenderTarget": {
      "exclude_methods": ["GetColorRTV", "GetDepthDSV", "GetSwapChain"],
      "methods": {"GetDesc": {"result": {"lifetime": "object"}}}
    },
    "Diligent::IRadientRenderer": {
      "methods": {"GetDesc": {"result": {"lifetime": "object"}}}
    },
    "Diligent::IRadientView": {
      "methods": {
        "GetDesc": {"result": {"lifetime": "object"}},
        "SetScene": {"parameters": {"pScene": {"nullable": true}}},
        "SetRenderTarget": {"parameters": {"pRenderTarget": {"nullable": true}}}
      }
    },
    "Diligent::RadientRenderAttribs": {
      "fields": {"pView": {"nullable": false}}
    },
    "Diligent::IRadientScene": {
      "methods": {
        "GetDesc": {
          "result": {"lifetime": "object"}
        },
        "GetRootEntities": {
          "parameters": {
            "pEntities": {"nullable": true, "length": "Capacity", "written": "NumEntitiesWritten"}
          }
        },
        "GetChildren": {
          "parameters": {
            "pChildren": {"nullable": true, "length": "ChildCount", "written": "NumChildrenWritten"}
          }
        },
        "GetSceneRevisions": {
          "result": {"lifetime": "object"}
        }
      }
    },
    "Diligent::IRadientSceneWriter": {
      "exclude_methods": ["SetCustomComponentData"],
      "methods": {
        "SetEntityName": {
          "parameters": {
            "Name": {"nullable": true}
          }
        }
      }
    },
    "Diligent::IRadientAssetManager": {
      "exclude_methods": ["RegisterSceneAssetImporter", "Stop"]
    },
    "Diligent::IRadientMaterialAsset": {
      "methods": {
        "GetParameter": {
          "parameters": {
            "pData": {"length": "DataSize"}
          }
        }
      }
    },
    "Diligent::RadientCubeMeshCreateInfo": {
      "fields": {
        "pFaceColors": {"length": 6}
      }
    },
    "Diligent::RadientMeshCreateInfo": {
      "fields": {
        "pPrimitives": {"length": "PrimitiveCount"}
      }
    },
    "Diligent::RadientMeshVertexData": {
      "fields": {
        "ppVertexBuffers": {"length": "VertexLayout.BufferCount", "element_nullable": true}
      }
    },
    "Diligent::RadientVertexLayoutDesc": {
      "fields": {
        "pAttributes": {"length": "AttributeCount"},
        "pBuffers": {"length": "BufferCount"}
      }
    },
    "Diligent::RadientMeshAssetDesc": {
      "fields": {
        "pGeometries": {"length": "GeometryCount"},
        "pPrimitives": {"length": "PrimitiveCount"},
        "pMorphTargets": {"length": "MorphTargetCount"}
      }
    },
    "Diligent::RadientMeshMorphTargetData": {
      "fields": {
        "pMorphTargets": {"length": "MorphTargetCount"}
      }
    },
    "Diligent::RadientMorphTargetDesc": {
      "fields": {
        "pAttributes": {"length": "AttributeCount"}
      }
    },
    "Diligent::RadientMorphTargetCreateInfo": {
      "fields": {
        "pAttributeData": {"length": "Desc.AttributeCount"}
      }
    },
    "Diligent::RadientTextureData": {
      "fields": {
        "pMipLevels": {"length": "MipLevelCount"}
      }
    },
    "Diligent::RadientMaterialDefinitionDesc": {
      "fields": {
        "pParameters": {"length": "ParameterCount"}
      }
    },
    "Diligent::RadientMaterialParameterDesc": {
      "fields": {
        "pDefaultValue": {"binding": "manual", "reason": "The byte count is derived from the reflected parameter type and array size."}
      }
    },
    "Diligent::RadientMaterialBindingsComponent": {
      "fields": {
        "pBindings": {"length": "BindingCount"}
      }
    },
    "Diligent::IRadientMaterialWriter": {
      "methods": {
        "SetParameter": {
          "parameters": {
            "pData": {"length": "DataSize"}
          }
        },
        "SetTexture": {
          "parameters": {
            "pTexture": {"nullable": true}
          }
        }
      }
    },
    "Diligent::RadientSkeletonDesc": {
      "fields": {
        "pJoints": {"length": "JointCount"}
      }
    },
    "Diligent::RadientSkinDesc": {
      "fields": {
        "pJoints": {"length": "JointCount"},
        "pSkeleton": {"nullable": false}
      }
    },
    "Diligent::IRadientSkeletonPose": {
      "methods": {
        "GetJointLocalTransforms": {
          "parameters": {
            "pTransforms": {"length": "JointCount"}
          }
        },
        "GetJointGlobalMatrices": {
          "parameters": {
            "pMatrices": {"length": "JointCount"}
          }
        },
        "ComputeSkinningMatrices": {
          "parameters": {
            "pMatrices": {
              "length_from": {"parameter": "pSkin", "method": "GetDesc", "field": "JointCount"}
            }
          }
        }
      }
    },
    "Diligent::IRadientSkeletonPoseWriter": {
      "methods": {
        "SetJointLocalTransforms": {
          "parameters": {
            "pTransforms": {"nullable": true, "length": "JointCount"}
          }
        }
      }
    },
    "Diligent::IRadientMorphTargetWeights": {
      "methods": {
        "GetWeights": {
          "result": {"nullable": true, "lifetime": "object", "length_method": "GetWeightCount"}
        },
        "SetWeights": {
          "parameters": {
            "pWeights": {"nullable": true, "length": "WeightCount"}
          }
        }
      }
    },
    "Diligent::RadientAnimationClipDesc": {
      "fields": {
        "pTargets": {"length": "TargetCount"},
        "pSamplers": {"length": "SamplerCount"},
        "pChannels": {"length": "ChannelCount"}
      }
    },
    "Diligent::RadientAnimationSamplerDesc": {
      "fields": {
        "pTimes": {"length": "KeyframeCount"},
        "pValues": {"length": "ValueDataSize"}
      }
    },
    "Diligent::RadientAnimationBindingDesc": {
      "fields": {
        "pDestinations": {"length": "DestinationCount"}
      }
    },
    "Diligent::RadientAnimationDestinationDesc": {
      "fields": {
        "pMappings": {"length": "MappingCount"},
        "pDestination": {"nullable": false}
      }
    },
    "Diligent::IRadientAnimationDestination": {
      "exclude_methods": ["CreateBinding"]
    },
    "Diligent::IRadientAnimationRegistry": {
      "methods": {
        "AddAnimationBinding": {
          "parameters": {
            "pEntities": {"nullable": true, "length": "EntityCount"}
          }
        },
        "RemoveAnimationBinding": {
          "parameters": {
            "pEntities": {"nullable": true, "length": "EntityCount"}
          }
        }
      }
    },
    "Diligent::RadientAnimationRegistryState": {
      "fields": {
        "pEntries": {"length": "EntryCount"}
      }
    },
    "Diligent::RadientAnimationRegistryEntry": {
      "fields": {
        "ppBindings": {"length": "BindingCount"},
        "pClip": {"nullable": false}
      }
    },
    "Diligent::RadientSceneLoadInfo": {
      "fields": {
        "URI": {"nullable": false}
      }
    },
    "Diligent::RadientSceneAssetDesc": {
      "fields": {
        "ppAnimationClips": {"length": "AnimationClipCount"}
      }
    },
    "Diligent::RadientAnimationChannelDesc": {
      "fields": {
        "Property": {"nullable": false}
      }
    },
    "Diligent::RadientMorphTargetAttributeCreateInfo": {
      "fields": {
        "pDeltaBuffer": {"nullable": false}
      }
    },
    "Diligent::RadientMorphTargetAttributeDesc": {
      "fields": {
        "Semantic": {"nullable": false}
      }
    },
    "Diligent::RadientTextureMipData": {
      "fields": {
        "pDataBlob": {"nullable": false}
      }
    },
    "Diligent::RadientVertexAttributeDesc": {
      "fields": {
        "Semantic": {"nullable": false}
      }
    }
  }
}
